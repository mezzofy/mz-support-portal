# web-support — Support-Staff Console environment

# GraphQL endpoint of svc-support (frozen: /support/api/graphql on port 8005)
VITE_SUPPORT_API_URL=http://localhost:8005/support/api/graphql

# Gateway + IAM redirect targets (staff login flow)
VITE_GATEWAY_URL=http://localhost:8005
VITE_AUTH_URL=http://localhost:5173

# Local development bypass — skips real staff token, sends X-Agent-Id dev header.
# svc-support honours X-Agent-Id only when ENVIRONMENT=development.
VITE_MOCK_AUTH=true
VITE_DEV_AGENT_ID=agent-dev-001
VITE_DEV_AGENT_NAME=Dev Agent
VITE_DEV_AGENT_TEAM=SUPPORT
