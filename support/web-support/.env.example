# web-support — Support-Staff Console environment

# GraphQL endpoint of svc-support (frozen: /support/api/graphql on port 8005)
VITE_SUPPORT_API_URL=http://localhost:8005/support/api/graphql

# mz-ai-assistant auth API base (Option B: staff reuse the mz-ai login).
# The console calls ${VITE_AUTH_API_URL}/auth/login and /auth/verify-otp.
# NOTE: the mz-ai-assistant server must allow this console's origin in its CORS config.
VITE_AUTH_API_URL=http://localhost:8000

# Local development bypass — skips the real login, sends the X-Agent-Id dev header.
# svc-support honours X-Agent-Id only when ENVIRONMENT=development.
VITE_MOCK_AUTH=true
VITE_DEV_AGENT_ID=agent-dev-001
VITE_DEV_AGENT_NAME=Dev Agent
VITE_DEV_AGENT_TEAM=SUPPORT
