# svc-support environment (Option B: Postgres + mz-ai-assistant JWT reuse).
# Copy to .env and fill real values on each host. .env is gitignored (secrets stay off git).

ENVIRONMENT=production

# The SAME mezzofy_ai database the mz-ai-assistant server uses.
# Accepts the mz-ai DATABASE_URL verbatim (postgresql+asyncpg://... is normalized for psycopg2).
DATABASE_URL=postgresql+asyncpg://mezzofy_ai:CHANGE_ME@localhost:5432/mezzofy_ai

# MUST equal the mz-ai-assistant server's JWT_SECRET so svc-support can validate its access tokens.
JWT_SECRET=CHANGE_ME_SAME_AS_MZ_AI_JWT_SECRET
JWT_ALGORITHM=HS256

PORT=8005
